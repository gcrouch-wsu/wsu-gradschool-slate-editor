{
  "name": "wsu-gradschool-slate-editor",
  "version": "1.0.0",
  "description": "WSU Graduate School Slate Editor",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcrouch-wsu/wsu-gradschool-slate-editor.git"
  },
  "bugs": {
    "url": "https://github.com/gcrouch-wsu/wsu-gradschool-slate-editor/issues"
  },
  "homepage": "https://github.com/gcrouch-wsu/wsu-gradschool-slate-editor#readme",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "check": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:browser": "playwright test",
    "migrate": "node scripts/migrate.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "create-user": "node scripts/create-user.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md}\"",
    "checkfmt": "prettier -c \"**/*.{ts,tsx,js,jsx,css,md}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-link": "^3.10.6",
    "@tiptap/extension-placeholder": "^3.10.6",
    "@tiptap/extension-table": "^3.10.6",
    "@tiptap/extension-table-cell": "^3.10.6",
    "@tiptap/extension-table-header": "^3.10.6",
    "@tiptap/extension-table-row": "^3.10.6",
    "@tiptap/extension-text-align": "^3.10.6",
    "@tiptap/extension-underline": "^3.10.6",
    "@tiptap/react": "^3.10.6",
    "@tiptap/starter-kit": "^3.10.6",
    "diff": "^9.0.0",
    "htmlparser2": "^10.1.0",
    "jose": "^6.1.3",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.16",
    "embedded-postgres": "^18.1.0-beta.16",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
