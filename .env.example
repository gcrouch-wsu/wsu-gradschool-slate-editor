# Copy to .env for local development. Do not commit .env.

# local (Vercel staff editing), public (open editor, no database), development, or okta.
# Vercel uses local. development is refused in production. okta is a later release.
AUTH_MODE=local

# Required in Okta mode. Also required for any database-backed local run.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/slate_editor

# Required for local accounts and Okta. At least 32 characters.
# Okta uses it to sign the temporary state cookie.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Required in Okta mode. Exact origin registered with Okta, without a trailing slash.
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Required in Okta mode.
OKTA_ISSUER=https://login.example.edu
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# Optional. Defaults to 8 hours. Minimum 300 seconds.
SESSION_TTL_SECONDS=28800

# Optional connection pool size. Defaults to 10.
DATABASE_POOL_MAX=10

# Production start binds HOSTNAME (default 0.0.0.0) and PORT (default 3000).
PORT=3000
